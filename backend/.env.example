# .env file
# This file stores environment variables for your Django project.
# It should NOT be committed to version control.

SECRET_KEY=your_django_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PII Encryption Key (recommended for production)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If not set, encryption will fall back to deriving key from SECRET_KEY
PII_ENCRYPTION_KEY=
# To generate a new key, run:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

MONGO_DATABASE_HOST=mongo_host_url # i.e. localhost or mongodb+srv://cluster_name.example.mongodb.net 
MONGO_DATABASE_NAME=database_name # the database name, a new database will be created if it doesn't already exists in the cluster
MONGO_DATABASE_USER=database_user
MONGO_DATABASE_PWD=database_password
MONGO_DATABASE_PORT=27017
MONGO_DATABASE_TLS=true #set false if using a local mongodb
MONGO_DATABASE_SSL=true #set false if using a local mongodb


CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# =============================================================================
# EMAIL CONFIGURATION (for password reset)
# =============================================================================
# For development, emails print to console by default.
# For production, configure SMTP:

# Email backend options:
# - django.core.mail.backends.console.EmailBackend (dev - prints to console)
# - django.core.mail.backends.smtp.EmailBackend (production - sends emails)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP settings (for production)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@planningjam.com

# Password reset settings
PASSWORD_RESET_EXPIRY_HOURS=24
FRONTEND_URL=http://localhost:5173